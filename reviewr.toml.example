# Copy to reviewr.toml (gitignored) and edit.

[editor]
default = "vscode"

# Each editor is an argv list. Placeholders: {root} (the worktree, opened as the
# project), {path} (absolute file path), {line}. These override or add to the built-in
# entries, e.g. vscode = ["code", "{root}", "--goto", "{path}:{line}"].
[editors]
# zed = ["zed", "{root}", "{path}:{line}"]

[llm]
model = "claude-opus-5-5"
effort = "medium"

# Map each GitHub repo to a local clone. Diffs are computed from this clone,
# so it must contain the PR's base and head commits (`git fetch origin`).
# "Open in editor" uses the worktree that has the PR's branch checked out,
# falling back to this path.
[repos."mosaic-pe/mosaic-app"]
path = "~/Projects/mosaic/mosaic-app"
# Put first on PATH for installs and checks: the Node version from the repo's .nvmrc.
path_prepend = ["~/.nvm/versions/node/v24.19.0/bin"]
# Never run per work item.
exclude_tests = ["src/e2e/*", "*e2e*", "*playwright*", "*cypress*"]

# Dependencies are installed from the lockfiles on the branch under review (not your
# clone), cached by lockfile contents under reviewr's data folder, and linked into
# reviewr's worktrees at the `provides` paths while drafts and checks run.
[[repos."mosaic-pe/mosaic-app".envs]]
name = "backend"
files = ["src/backend/requirements.txt", "src/backend/requirements-dev.txt"]
install = [
  ["uv", "venv", "--python", "3.14", ".venv"],
  ["uv", "pip", "install", "--python", ".venv/bin/python", "-r", "src/backend/requirements-dev.txt"],
]
provides = { "src/backend/.venv" = ".venv" }
# No seed needed: uv installs from its shared package cache using copy-on-write
# clones, so a new virtualenv for a changed requirements file is quick and small.

[[repos."mosaic-pe/mosaic-app".envs]]
name = "frontend"
files = ["src/frontend/package.json", "src/frontend/package-lock.json", "src/frontend/.npmrc", ".nvmrc"]
install = [["npm", "ci", "--prefix", "src/frontend", "--no-audit", "--no-fund"]]
provides = { "src/frontend/node_modules" = "src/frontend/node_modules" }
# When the lockfile changes, start from a copy-on-write clone of the previous install
# and let npm apply only the differences.
seed = ["src/frontend/node_modules"]
install_seeded = [["npm", "install", "--prefix", "src/frontend", "--no-audit", "--no-fund", "--no-save"]]

# Checks run on a work item's changed files only. `match` globs are relative to the
# repo root; {files} and {tests} are relative to `cwd`.
[[repos."mosaic-pe/mosaic-app".checks]]
name = "Backend format (black)"
kind = "lint"
match = ["src/backend/*.py"]
cwd = "src/backend"
run = [".venv/bin/black", "--check", "--diff", "--quiet", "{files}"]

[[repos."mosaic-pe/mosaic-app".checks]]
name = "Backend tests (pytest)"
kind = "test"
match = ["src/backend/*.py"]
cwd = "src/backend"
discover = "python"
run = [".venv/bin/python", "-m", "pytest", "-q", "-o", "addopts=", "-p", "no:cacheprovider", "{tests}"]

[[repos."mosaic-pe/mosaic-app".checks]]
name = "Frontend lint (eslint)"
kind = "lint"
match = ["src/frontend/src/*.ts", "src/frontend/src/*.tsx"]
cwd = "src/frontend"
run = ["node_modules/.bin/eslint", "--max-warnings", "0", "--no-warn-ignored", "{files}"]

[[repos."mosaic-pe/mosaic-app".checks]]
name = "Frontend tests (jest)"
kind = "test"
match = ["src/frontend/src/*.ts", "src/frontend/src/*.tsx"]
cwd = "src/frontend"
discover = ["node_modules/.bin/jest", "--listTests", "--findRelatedTests", "{files}"]
run = ["node_modules/.bin/jest", "--ci", "{tests}"]

# Issue tracking. The token comes from JIRA_API_TOKEN (and the email from JIRA_EMAIL
# unless set here), e.g. in .env.
# [jira]
# base_url = "https://yourcompany.atlassian.net"
# project = "MOS"
# issue_type = "Task"
